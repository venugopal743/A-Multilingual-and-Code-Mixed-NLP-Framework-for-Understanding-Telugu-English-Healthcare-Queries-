# ===========================================
# Environment Configuration
# A Multilingual and Code-Mixed NLP Framework
# for Understanding Healthcare Queries
# ===========================================

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/healthcare_nlp
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/healthcare_nlp

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d

# ---- Server Ports ----
BACKEND_PORT=5000
NLP_ENGINE_PORT=8000
FRONTEND_PORT=5173

# ---- NLP Engine URL (used by backend) ----
NLP_ENGINE_URL=http://localhost:8000

# ---- OpenAI (Optional - for enhanced LLM responses) ----
# OPENAI_API_KEY=sk-your-key-here

# ---- Model Configuration ----
MODEL_DIR=./models/saved
DATA_DIR=./data
FAISS_INDEX_PATH=./models/embeddings/medical_index.faiss

# ---- App Settings ----
NODE_ENV=development
DEBUG=true
CORS_ORIGIN=http://localhost:5173
